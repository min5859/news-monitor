{
  "target": {
    "name": "조현준",
    "display_name": "회장님",
    "organization": "효성",
    "person_aliases": ["조현준", "Cho Hyun-joon", "Cho Hyun Joon", "Hyun-Joon Cho"],
    "organization_aliases": ["효성", "Hyosung"]
  },
  "collection": {
    "provider": "gdelt_doc",
    "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc",
    "queries": ["(Hyosung OR \"Cho Hyun-joon\" OR \"Hyun-Joon Cho\")"],
    "lookback_days": 14,
    "max_results_per_query": 30,
    "max_articles": 30,
    "max_title_chars": 1000,
    "max_response_bytes": 2000000,
    "timeout_seconds": 20,
    "attempts": 2,
    "backoff_seconds": 8,
    "max_retry_wait_seconds": 30,
    "query_interval_seconds": 6,
    "minimum_run_interval_seconds": 60,
    "rate_limit_cooldown_seconds": 900,
    "publisher_goal": 5,
    "user_agent": "news-monitor-sample/0.1",
    "attribution_name": "The GDELT Project",
    "attribution_url": "https://www.gdeltproject.org/",
    "tracking_query_parameters": ["fbclid", "gclid"]
  },
  "analysis": {
    "provider": "cursor",
    "model": "claude-sonnet-5-5-medium",
    "prompt_file": "prompts/classify.md",
    "attempts": 2,
    "timeout_seconds": 90,
    "max_output_bytes": 65536,
    "max_calls_per_run": 30,
    "max_reason_chars": 240,
    "max_evidence_chars": 200,
    "max_collection_age_hours": 24
  }
}
